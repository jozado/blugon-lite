#!/bin/bash
set -e

case "$1" in
    purge)
        # Actualizar caché de iconos
        if [ -x /usr/bin/update-icon-caches ]; then
            update-icon-caches /usr/share/icons/hicolor 2>/dev/null || true
        fi
        
        # Actualizar caché de desktop
        if [ -x /usr/bin/update-desktop-database ]; then
            update-desktop-database /usr/share/applications 2>/dev/null || true
        fi
        ;;
    
    remove|deconfigure|abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "Usage: postrm purge" >&2
        exit 1
        ;;
esac

exit 0
