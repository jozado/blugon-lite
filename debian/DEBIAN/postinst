#!/bin/bash
# postinst - Sin set -e para permitir fallos controlados

case "$1" in
    configure)
        # Copiar autostart a /etc/xdg/autostart/ para autoinicio global (XFCE, GNOME, KDE)
        if [ -d /etc/xdg ] && [ -d /etc/xdg/autostart ]; then
            cp /usr/share/applications/blugon-lite-autostart.desktop /etc/xdg/autostart/blugon-lite.desktop 2>/dev/null || true
            chmod 644 /etc/xdg/autostart/blugon-lite.desktop 2>/dev/null || true
            echo "  Autoinicio: El daemon se iniciará automáticamente al iniciar sesión"
        fi

        # Copiar autostart de XDG a cada usuario si no existe
        if [ -d /home ]; then
            for user_home in /home/*; do
                if [ -d "$user_home" ] && [ "$(basename "$user_home")" != "debian" ] && [ "$(basename "$user_home")" != "lost+found" ]; then
                    user=$(basename "$user_home")
                    config_dir="$user_home/.config/blugon"

                    # Verificar que es un usuario real (tiene UID >= 1000)
                    user_uid=$(id -u "$user" 2>/dev/null) || continue
                    if [ "$user_uid" -lt 1000 ] 2>/dev/null; then
                        continue
                    fi

                    # Crear directorio de configuración
                    if [ ! -d "$config_dir" ]; then
                        mkdir -p "$config_dir" 2>/dev/null || true
                        chown $user:$user "$config_dir" 2>/dev/null || true
                        chmod 755 "$config_dir" 2>/dev/null || true
                    fi

                    # Copiar configuración por defecto si no existe
                    if [ ! -f "$config_dir/gamma" ]; then
                        cp /usr/share/blugon-lite/configs/evening/gamma "$config_dir/gamma" 2>/dev/null || true
                        chown $user:$user "$config_dir/gamma" 2>/dev/null || true
                        chmod 644 "$config_dir/gamma" 2>/dev/null || true
                    fi

                    # Copiar autostart de XDG si no existe
                    autostart_dir="$user_home/.config/autostart"
                    if [ ! -d "$autostart_dir" ]; then
                        mkdir -p "$autostart_dir" 2>/dev/null || true
                        chown $user:$user "$autostart_dir" 2>/dev/null || true
                    fi

                    if [ ! -f "$autostart_dir/blugon-lite.desktop" ]; then
                        cp /usr/share/applications/blugon-lite-autostart.desktop "$autostart_dir/blugon-lite.desktop" 2>/dev/null || true
                        chown $user:$user "$autostart_dir/blugon-lite.desktop" 2>/dev/null || true
                    fi

                    # Registrar explícitamente en XFCE si está disponible
                    if command -v xfce4-session-settings > /dev/null 2>&1; then
                        echo "  XFCE detectado: Agregando al autoinicio de XFCE..."
                        # Usar xfce4-session-settings para registrar la aplicación
                        su "$user" -c "xfce4-session-settings --sm-save-legacy 2>/dev/null || true"
                    fi
                fi
            done
        fi

        # Nota: El servicio systemd no se recomienda para daemons que necesitan X11
        # El autoinicio vía .desktop es el método preferido

        # Actualizar caché de iconos y desktop (sin fallar)
        if [ -x /usr/bin/update-icon-caches ]; then
            update-icon-caches /usr/share/icons/hicolor 2>/dev/null || true
        fi

        if [ -x /usr/bin/update-desktop-database ]; then
            update-desktop-database /usr/share/applications 2>/dev/null || true
        fi

        echo ""
        echo "blugon-lite instalado exitosamente."
        echo ""
        echo "Para comenzar:"
        echo "  1. Ejecuta 'blugon-lite-tui' para configurar horarios"
        echo "  2. O ejecuta 'blugon-lite --once' para aplicar el filtro"
        echo ""
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        # No hacer nada en aborts
        ;;
    
    *)
        echo "Usage: postinst configure" >&2
        exit 1
        ;;
esac

exit 0
