#!/bin/bash
# postrm - NO USAR set -e para permitir desinstalación incluso con errores

LOGFILE="/tmp/blugon-postrm-debug.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] postrm iniciado con argumento: $1" >> "$LOGFILE"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] PID: $$, USER: $(whoami)" >> "$LOGFILE"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] DISPLAY=${DISPLAY:-'no definido'}" >> "$LOGFILE"

# Función para restaurar gamma con fallback
restaurar_gamma() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Intentando restaurar gamma..." >> "$LOGFILE"

    # Establecer DISPLAY si no está definido
    export DISPLAY="${DISPLAY:-:0}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] DISPLAY=$DISPLAY" >> "$LOGFILE"

    # Método 1: xgamma -rgamma 1.0 -ggamma 1.0 -bgamma 1.0 (RECOMENDADO)
    # NOTA: NO usar blugon-lite --once porque aplica gamma según la hora
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Intentando xgamma -rgamma 1.0 -ggamma 1.0 -bgamma 1.0..." >> "$LOGFILE"
    if command -v xgamma > /dev/null 2>&1; then
        if xgamma -rgamma 1.0 -ggamma 1.0 -bgamma 1.0 >> "$LOGFILE" 2>&1; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✓ xgamma RGB exitoso - gamma restaurado a 6500K" >> "$LOGFILE"
            return 0
        else
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✗ xgamma RGB falló" >> "$LOGFILE"
        fi
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] xgamma no encontrado" >> "$LOGFILE"
    fi

    # Método 2: Fallback a xgamma -gamma 1.0
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Intentando xgamma -gamma 1.0..." >> "$LOGFILE"
    if xgamma -gamma 1.0 >> "$LOGFILE" 2>&1; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✓ xgamma -gamma 1.0 exitoso" >> "$LOGFILE"
        return 0
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✗ xgamma -gamma 1.0 falló" >> "$LOGFILE"
    fi

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ✗ TODOS los métodos fallaron" >> "$LOGFILE"
    return 1
}

case "$1" in
    purge)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: purge" >> "$LOGFILE"

        # Restaurar gamma normal antes de desinstalar (CRÍTICO)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] === RESTAURANDO GAMMA ===" >> "$LOGFILE"
        if restaurar_gamma; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] Gamma restaurado exitosamente" >> "$LOGFILE"
        else
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: No se pudo restaurar gamma" >> "$LOGFILE"
        fi

        # Actualizar caché de iconos (sin fallar)
        if [ -x /usr/bin/update-icon-caches ]; then
            update-icon-caches /usr/share/icons/hicolor >> "$LOGFILE" 2>&1 || echo "update-icon-caches falló" >> "$LOGFILE"
        fi

        # Actualizar caché de desktop (sin fallar)
        if [ -x /usr/bin/update-desktop-database ]; then
            update-desktop-database /usr/share/applications >> "$LOGFILE" 2>&1 || echo "update-desktop-database falló" >> "$LOGFILE"
        fi

        # Limpiar archivo de autoinicio global
        if [ -f /etc/xdg/autostart/blugon-lite.desktop ]; then
            rm -f /etc/xdg/autostart/blugon-lite.desktop >> "$LOGFILE" 2>&1 && \
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] Eliminado /etc/xdg/autostart/blugon-lite.desktop" >> "$LOGFILE" || \
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR al eliminar /etc/xdg/autostart/blugon-lite.desktop" >> "$LOGFILE"
        else
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] /etc/xdg/autostart/blugon-lite.desktop no existe" >> "$LOGFILE"
        fi

        # Limpiar configs de usuario en TODOS los homes
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Limpiando configs de usuario..." >> "$LOGFILE"
        if [ -d /home ]; then
            for user_home in /home/*; do
                if [ -d "$user_home" ] && [ "$(basename "$user_home")" != "debian" ]; then
                    user=$(basename "$user_home")
                    autostart_file="$user_home/.config/autostart/blugon-lite.desktop"
                    
                    if [ -f "$autostart_file" ]; then
                        rm -f "$autostart_file" >> "$LOGFILE" 2>&1 && \
                            echo "[$(date '+%Y-%m-%d %H:%M:%S')] Eliminado $autostart_file" >> "$LOGFILE" || \
                            echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR al eliminar $autostart_file" >> "$LOGFILE"
                    else
                        echo "[$(date '+%Y-%m-%d %H:%M:%S')] $autostart_file no existe" >> "$LOGFILE"
                    fi
                fi
            done
        fi
        
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] purge completado" >> "$LOGFILE"
        ;;

    remove)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: remove" >> "$LOGFILE"
        # En remove normal (sin purge), no restaurar gamma ni limpiar configs
        ;;

    deconfigure)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: deconfigure" >> "$LOGFILE"
        # En deconfigure, no hacer nada
        ;;

    abort-install)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: abort-install" >> "$LOGFILE"
        # Instalación abortada, limpiar
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: abort-*" >> "$LOGFILE"
        # Abortos, no hacer nada
        ;;

    failed-install)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: failed-install" >> "$LOGFILE"
        # Instalación fallida, limpiar
        ;;

    upgrade)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: upgrade" >> "$LOGFILE"
        # Después de upgrade, no hacer nada
        ;;

    disappear)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: disappear" >> "$LOGFILE"
        # Paquete desapareciendo, no hacer nada
        ;;

    failed-remove)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Ejecutando caso: failed-remove (CRÍTICO)" >> "$LOGFILE"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Verificando estado de archivos:" >> "$LOGFILE"
        ls -la /usr/bin/blugon-lite >> "$LOGFILE" 2>&1 || echo "/usr/bin/blugon-lite no existe" >> "$LOGFILE"
        ls -la /usr/bin/blugon-lite-tui >> "$LOGFILE" 2>&1 || echo "/usr/bin/blugon-lite-tui no existe" >> "$LOGFILE"
        ;;

    *)
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Argumento desconocido: $1" >> "$LOGFILE"
        echo "Usage: postrm purge|remove|deconfigure|abort-install|abort-upgrade|abort-remove|abort-deconfigure|failed-install|upgrade|disappear" >&2
        exit 1
        ;;
esac

echo "[$(date '+%Y-%m-%d %H:%M:%S')] postrm finalizando con exit 0" >> "$LOGFILE"
# Siempre salir con éxito para no bloquear desinstalación
exit 0
